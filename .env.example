# ==============================================================================
# Powertech Engineers Website - Environment Variables Template
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets or sensitive credentials into source control.
# ==============================================================================

# Application URL (used for canonical URLs, sitemaps, OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Configuration (Optional - only required if database/enquiry features are enabled)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only key: NEVER expose this with NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Contact & Enquiry Form Handling
CONTACT_FORM_RECIPIENT_EMAIL=enquiry@powertech.example.com

# Form Spam Protection (Turnstile or reCAPTCHA v3)
NEXT_PUBLIC_CAPTCHA_SITE_KEY=your-captcha-site-key-here
CAPTCHA_SECRET_KEY=your-captcha-secret-key-here
